{{- /* The pages a search engine should index (_partials/listed.html). <lastmod> comes from Git with enableGitInfo
(README.md), else from the front matter. A sitemap needs one URL, so a site that is all noindex lists its home page. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{- $pages := slice }}
{{- range where .Pages "Sitemap.Disable" "ne" true }}
  {{- if partial "listed.html" . }}{{ $pages = $pages | append . }}{{ end }}
{{- end }}
{{- if not $pages }}{{ $pages = slice site.Home }}{{ end }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range $pages }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
</urlset>
